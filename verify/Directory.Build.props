<Project>
  <!-- The verify tool builds against the game's own assemblies, resolved the way exmod provisions
       them: the VINTAGE_STORY environment variable, else the checkout's .game/<slug>-server or
       .game/<slug>. Kept here rather than taken from the ExpandedLib package: the tool depends on
       nothing of exlib's. -->
  <PropertyGroup>
    <GameSlug Condition="'$(GameSlug)' == ''">1.22</GameSlug>
    <_GamePathEnv>$([System.Environment]::GetEnvironmentVariable('VINTAGE_STORY'))</_GamePathEnv>
    <GamePath Condition="'$(GamePath)' == ''">$(_GamePathEnv)</GamePath>
    <GamePath Condition="'$(GamePath)' == '' and Exists('$(MSBuildThisFileDirectory)..\.game\$(GameSlug)-server\VintagestoryAPI.dll')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\.game\$(GameSlug)-server'))</GamePath>
    <GamePath Condition="'$(GamePath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\.game\$(GameSlug)'))</GamePath>
  </PropertyGroup>
  <Target Name="_CheckGamePath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GamePath)\VintagestoryAPI.dll')" Text="No Vintage Story install at GamePath='$(GamePath)'. Run 'scripts/exmod.sh provision game -Kind server' or set VINTAGE_STORY." />
  </Target>
</Project>
